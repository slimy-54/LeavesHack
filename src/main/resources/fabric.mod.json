{
  "schemaVersion": 1,
  "id": "leaveshack",
  "version": "${version}",
  "name": "LeavesHack",
  "description": "(26.1.2 port) 致力于改善无政府服务器生存体验的 MeteorClient 插件 dev：Leaves_awa",
  "authors": [
    "Leaves_awa"
  ],
  "contact": {
    "sources": "https://github.com/MrBZBZ/LeavesHack"
  },
  "icon": "assets/leaves/icon.png",
